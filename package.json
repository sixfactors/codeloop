{
  "name": "@protoboxai/codeloop",
  "version": "0.4.1",
  "description": "Self-improving development workflow for AI coding agents",
  "homepage": "https://codeloop.protobox.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixfactors/codeloop.git"
  },
  "bugs": {
    "url": "https://github.com/sixfactors/codeloop/issues"
  },
  "type": "module",
  "bin": {
    "codeloop": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/local": {
      "types": "./dist/sdk/local.d.ts",
      "default": "./dist/sdk/local.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:ui": "cd ui && npm run build",
    "build:all": "tsc && npm --prefix ui run build && node scripts/build-workspace.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build:all",
    "build:workspace": "node scripts/build-workspace.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "workflow",
    "developer-tools",
    "cli",
    "ai-coding"
  ],
  "author": "Dean Grover",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "hono": "^4.12.0",
    "minisearch": "^7.2.0",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "templates",
    "starters",
    "registry"
  ]
}

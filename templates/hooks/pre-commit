#!/bin/sh
# Installed by `codeloop init --hooks` / `codeloop render --hooks`. A staged file outside the
# active card's plan.md `## Files` list refuses the commit with the list; a plan with no files
# list only warns. CODELOOP_GUARD=off skips this hook, as does a repo with no .codeloop/ or no
# active card.
[ "$CODELOOP_GUARD" = "off" ] && exit 0
[ -d .codeloop ] || exit 0
[ -s .codeloop/state/active-card ] || exit 0
# Install writes absolute paths here: GUI git clients start hooks with a bare PATH.
CODELOOP_NODE=${CODELOOP_NODE:-node}
codeloop=codeloop
export CODELOOP_NODE
[ -x "$codeloop" ] || codeloop=$(command -v codeloop) || codeloop=
if [ -z "$codeloop" ]; then
  echo "codeloop pre-commit: a card is active but codeloop is not installed where this hook looks, so the plan check cannot run. Run \`codeloop render --hooks\` again, or commit with CODELOOP_GUARD=off." >&2
  exit 1
fi
"$codeloop" guard diff --staged

#!/bin/sh
# Installed by `codeloop init --hooks` / `codeloop render --hooks`. Refuses a push unless the
# active card has passed its local gate. CODELOOP_GUARD=off skips this hook, as does a repo with
# no .codeloop/ or no active card.
[ "$CODELOOP_GUARD" = "off" ] && exit 0
[ -d .codeloop ] || exit 0
card=$(tr -d '[:space:]' < .codeloop/state/active-card 2>/dev/null)
[ -n "$card" ] || exit 0
# Install writes absolute paths here: GUI git clients start hooks with a bare PATH.
CODELOOP_NODE=${CODELOOP_NODE:-node}
codeloop=codeloop
export CODELOOP_NODE
[ -x "$codeloop" ] || codeloop=$(command -v codeloop) || codeloop=
if [ -z "$codeloop" ]; then
  echo "codeloop pre-push: $card is active but codeloop is not installed where this hook looks, so the gate check cannot run. Run \`codeloop render --hooks\` again, or push with CODELOOP_GUARD=off." >&2
  exit 1
fi
"$codeloop" gate check "$card" --require local

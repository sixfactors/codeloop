{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "codeloop guard edit" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "codeloop guard prompt" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "codeloop wiki capture --quiet" }]
      }
    ]
  }
}
